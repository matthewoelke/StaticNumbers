# Copy this file to .env and fill in values before running locally.
# Never commit a .env file with real secrets.

# Flask session signing key — set to a long random string in production
SECRET_KEY=change-this-before-deploying

# Path to the SQLite database file
# In Docker this defaults to /data/numbers.db (mounted volume)
# For local dev, leave unset to use the default (numbers.db next to app.py)
# DATABASE_PATH=/data/numbers.db
